# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini AI (Optional Cloud Fallback)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Local AI Model (Qwen2.5-Coder-7B via LM Studio)
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen2.5-coder-7b-instruct
LOCAL_EMBEDDING_URL=http://localhost:1234/v1
LOCAL_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
